// SentinelBox LED Control Service
// UUID F001: LED Control Service
// UUID F002: LED value — write 1 byte: 0=off 1=red 2=green 3=blue

PRIMARY_SERVICE, GAP_SERVICE
    CHARACTERISTIC, GAP_DEVICE_NAME, READ, "SentinelBox"

PRIMARY_SERVICE, GATT_SERVICE

PRIMARY_SERVICE, 0000F001-0000-1000-8000-00805F9B34FB
    CHARACTERISTIC, 0000F002-0000-1000-8000-00805F9B34FB, DYNAMIC | READ | WRITE | WRITE_WITHOUT_RESPONSE,
